# Single source of truth for the tool versions installed on the self-hosted runner.
#
# Consumers:
#   - .github/actions/setup-tools/action.yml  (asserts these are present on the runner)
#   - terraform/runner-bootstrap/main.tf      (reads this file and installs these versions)
#
# Anything that changes here must be re-applied to the runner (re-run
# terraform/runner-bootstrap, or update the tools in place -- see docs/runbook.md).
#
# Format: KEY=value, one per line. No quotes, no inline comments.

KUBECTL_VERSION=1.31.4
HELM_VERSION=3.16.3
TERRAFORM_VERSION=1.10.5
AWSCLI_VERSION=2.22.35
