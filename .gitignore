# Terraform
# Provider plugins and module caches: large, platform-specific, regenerated by
# `terraform init`. The .terraform.lock.hcl files ARE committed on purpose so that
# CI and the operator resolve identical provider versions.
.terraform/
*.tfplan
tfplan
tfplan.txt

# Local state. terraform/ec2-agent uses the S3 backend, so it should never appear
# there. terraform/runner-bootstrap is applied by hand and its state IS local --
# keep it out of git and store it somewhere durable and private instead
# (docs/bootstrap.md §5).
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable files may contain account IDs, subnet IDs and other environment
# specifics. terraform.tfvars examples live in docs/bootstrap.md.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Secrets that must never be committed. Belt and braces: the real ones live in
# GitHub environment secrets and SSM Parameter Store.
*.pem
kubeconfig
kubeconfig.b64
license.pem

# Rendered Helm values and other scratch output
/fixtures/
/rendered/

# Editor / OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/
